#!/bin/sh
set -e

# 1. Register global hotkey input permissions (Ctrl + Alt + G)
echo 'KERNEL=="event*", NAME="input/%k", MODE="0644", TAG+="uaccess"' > /etc/udev/rules.d/99-touch-grass-sim.rules
udevadm control --reload-rules || true
udevadm trigger || true

# 2. Place autostart trigger so GNOME spawns the wizard immediately for active users
mkdir -p /etc/xdg/autostart
cat << 'EOF' > /etc/xdg/autostart/touch-grass-sim-wizard.desktop
[Desktop Entry]
Type=Application
Name=Touch Grass SIM Setup Wizard
Exec=/usr/bin/touch-grass-sim
Icon=preferences-system-time
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
EOF

chmod 644 /etc/xdg/autostart/touch-grass-sim-wizard.desktop

exit 0